{
  "name": "shusann-blog",
  "type": "module",
  "license": "MIT",
  "private": true,
  "scripts": {
    "build": "next build",
    "dev": "next",
    "lint": "next typegen && oxlint",
    "lint:fix": "next typegen && oxlint --fix",
    "format": "prettier -w .",
    "prepare": "lefthook install",
    "postbuild": "pagefind --site out --output-path out/_pagefind",
    "typecheck": "next typegen && tsc --noEmit",
    "test:static": "node scripts/check-static-export.mjs",
    "test:e2e": "node scripts/check-http-pages.mjs"
  },
  "dependencies": {
    "@icons-pack/react-simple-icons": "13.15.1",
    "@next/third-parties": "16.3.7",
    "next": "16.3.7",
    "nextra": "4.6.1",
    "nextra-theme-blog": "4.6.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "sharp": "0.35.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "26.6.2",
    "@types/react": "19.3.0",
    "autoprefixer": "10.6.1",
    "lefthook": "2.1.15",
    "oxlint": "1.85.0",
    "oxlint-tsgolint": "7.0.2003",
    "pagefind": "1.5.2",
    "postcss": "8.5.28",
    "prettier": "3.9.9",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3"
  },
  "packageManager": "pnpm@12.8.1"
}
